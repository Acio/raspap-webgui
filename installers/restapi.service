[Unit]
Description=raspap-restapi
After=network.target

[Service]
User=raspap-api
WorkingDirectory=/etc/raspap/api
LimitNOFILE=4096
ExecStart=/etc/raspap/api/venv/bin/python -m uvicorn main:app --host 0.0.0.0 --port 8081
ExecStop=/bin/kill -HUP ${MAINPID}
Restart=on-failure
RestartSec=5s
# hardened fork: the API reads files and serves HTTP, it changes nothing on
# the system
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
ProtectSystem=full
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target

